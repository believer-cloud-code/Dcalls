# Copy to .env.local and fill in your keys

# --- Dcalls web ↔ app linking ---
# React app (Vite dev default port 3000)
VITE_APP_URL=http://localhost:3000
# Marketing landing (welcome.html after npm run sync:web)
VITE_MARKETING_URL=http://localhost:3000/welcome.html
VITE_HELP_URL=http://localhost:3000/help.html
# Production examples:
# VITE_APP_URL=https://app.dcalls.com
# VITE_MARKETING_URL=https://dcalls.com
# VITE_HELP_URL=https://dcalls.com/help.html

# --- Cloudflare Worker (required for the migration) ---
# API keys are stored as Cloudflare Worker secrets, not in VITE_ environment variables.
VITE_CLOUDFLARE_WORKER_URL=http://localhost:8787
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://<your-r2-public-url>

# Legacy Firebase Functions URL kept only for temporary fallback during migration.
VITE_API_BASE_URL=http://localhost:5001/dcalls-2d01d/us-central1

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dcalls-2d01d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dcalls-2d01d
VITE_FIREBASE_STORAGE_BUCKET=dcalls-2d01d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=default
VITE_FIREBASE_VAPID_KEY=

# --- WebRTC TURN (optional) ---
VITE_TURN_URL=free.expressturn.com:3478
VITE_TURN_USERNAME=000000002088354415
VITE_TURN_CREDENTIAL=XcNZ8ROFqq/ahN1AKpB+ZU1V6KM=