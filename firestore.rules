          (
            (
              request.resource.data.senderId == request.auth.uid &&
              request.resource.data.isEncrypted == true &&
              request.resource.data.encryptionMethod == 'matrix-megolm' &&
              request.resource.data.cryptoVersion == 2 &&
              request.resource.data.text is string &&
              (
                request.resource.data.type == 'text' ||
                (
                  (request.resource.data.type == 'image' || request.resource.data.type == 'file') &&
                  request.resource.data.attachmentEncrypted == true &&
                  request.resource.data.fileUrl is string
                )
              )
            ) ||
            (
              request.resource.data.senderId == 'ai' &&
              request.resource.data.isAi == true &&
              request.resource.data.type == 'text'
            )
          );
        // Message contents and encrypted attachment references are immutable.
        // Only delivery/read status and user feedback may be updated.
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feedback', 'feedbackAt']);
      }
    }
    
    match /usernames/{username} {
      // Authenticated users may resolve a username, but cannot enumerate or mutate
      // other users' username reservations.
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.usernameLower == username &&
        request.resource.data.username is string &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == username;
      allow update, delete: if false;
    }
    
    match /ai_feedback/{feedbackId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
  }
}
) &&
          request.resource.data.sourceDeviceId is string &&
          request.resource.data.sourceDeviceId.size() <= 128 &&
          exists(/databases/$(database)/documents/users/$(userId)/devices/$(request.resource.data.sourceDeviceId)) &&
          !('revokedAt' in get(/databases/$(database)/documents/users/$(userId)/devices/$(request.resource.data.sourceDeviceId)).data) &&
          request.resource.data.hpkePublicKey is string &&
          request.resource.data.hpkePublicKey.size() >= 40 &&
          request.resource.data.hpkePublicKey.size() <= 100 &&
          request.resource.data.state == 'waiting' &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt > request.time &&
          request.resource.data.expiresAt <= request.time + duration.value(6, 'm') &&
          request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.sourceDeviceId == resource.data.sourceDeviceId &&
          request.resource.data.hpkePublicKey == resource.data.hpkePublicKey &&
          request.resource.data.expiresAt == resource.data.expiresAt &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'state', 'joinedDeviceId', 'updatedAt', 'verifiedAt'
          ]) &&
          (
            (resource.data.state == 'waiting' &&
              request.resource.data.state == 'joined' &&
              request.resource.data.joinedDeviceId is string &&
              !('verifiedAt' in request.resource.data)) ||
            (resource.data.state == 'joined' &&
              request.resource.data.state == 'accepted' &&
              request.resource.data.joinedDeviceId == resource.data.joinedDeviceId &&
              !('verifiedAt' in request.resource.data)) ||
            (resource.data.state == 'accepted' &&
              request.resource.data.state == 'verified' &&
              request.resource.data.joinedDeviceId == resource.data.joinedDeviceId &&
              request.resource.data.verifiedAt == request.time) ||
            (resource.data.state in ['waiting', 'joined', 'accepted'] &&
              request.resource.data.state == 'cancelled' &&
              (('joinedDeviceId' in resource.data &&
                request.resource.data.joinedDeviceId == resource.data.joinedDeviceId) ||
               (!('joinedDeviceId' in resource.data) &&
                !('joinedDeviceId' in request.resource.data)))) ||
            (resource.data.state == 'verified' &&
              request.resource.data.state == 'cancelled' &&
              request.resource.data.joinedDeviceId == resource.data.joinedDeviceId &&
              request.resource.data.verifiedAt == resource.data.verifiedAt &&
              !exists(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)/messages/secrets))
          );
        allow delete: if isOwner(userId) &&
          resource.data.state != 'verified';

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) &&
            get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.expiresAt > request.time &&
            request.resource.data.ciphertext is string &&
            request.resource.data.ciphertext.size() <= 200000 &&
            (
              (messageId == 'join' &&
                getAfter(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.state == 'joined' &&
                request.resource.data.senderDeviceId is string &&
                request.resource.data.senderDeviceId != get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.sourceDeviceId &&
                request.resource.data.senderDeviceId == getAfter(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.joinedDeviceId) ||
              (messageId == 'accept' &&
                get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.state == 'joined' &&
                getAfter(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.state == 'accepted') ||
              (messageId == 'final' &&
                get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.state == 'accepted') ||
              (messageId == 'secrets' &&
                get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.state == 'verified' &&
                request.resource.data.senderDeviceId == get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.sourceDeviceId) ||
              (messageId == 'secretsAck' &&
                get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.state == 'verified' &&
                request.resource.data.senderDeviceId == get(/databases/$(database)/documents/users/$(userId)/deviceLinkSessions/$(sessionId)).data.joinedDeviceId)
            );
          allow update, delete: if false;
        }
      }

      match /crossSigning/{identityId} {
        // Cross-signing public keys and signatures are public verification
        // material; private signing seeds must never be stored here.
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) &&
          identityId == 'current' &&
          request.resource.data.masterKey is map &&
          request.resource.data.selfSigningKey is map &&
          request.resource.data.userSigningKey is map &&
          request.resource.data.signatures is map &&
          request.resource.data.protocol == 'matrix-cross-signing-v1';
        allow update: if isOwner(userId) &&
          identityId == 'current' &&
          request.resource.data.masterKey == resource.data.masterKey &&
          request.resource.data.selfSigningKey == resource.data.selfSigningKey &&
          request.resource.data.userSigningKey == resource.data.userSigningKey &&
          request.resource.data.protocol == resource.data.protocol &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatures', 'updatedAt']);
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMessage(request.resource.data);
      }

      match /damai_messages/{messageId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMessage(request.resource.data);
      }

      match /damai_chats/{chatId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }

      match /calls/{callId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /recordings/{recordingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidRecording(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /ai_memory/{memoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMemory(request.resource.data);
      }

      match /feedback/{feedbackId} {
        allow read, create, update: if isOwner(userId);
      }

      match /contacts/{contactId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidContact(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /privateMessaging/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /devices/{deviceId} {
        // Device keys are public cryptographic material; private crypto state
        // must never be written to this collection.
        allow read: if isAuthenticated();
        // A registered device identity is immutable. Re-uploading the same
        // signed keys is allowed, but a device cannot silently replace them.
        allow create: if isOwner(userId) &&
          request.resource.data.deviceId == deviceId &&
          request.resource.data.deviceKeys is map &&
          request.resource.data.deviceKeys.device_id == deviceId;
        allow update: if isOwner(userId) &&
          request.resource.data.deviceId == resource.data.deviceId &&
          request.resource.data.deviceKeys == resource.data.deviceKeys &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'updatedAt', 'fallbackKeys', 'protocol', 'protocolVersion', 'revokedAt', 'revokedBy'
          ]) &&
          (
            (!('revokedAt' in resource.data) && !('revokedAt' in request.resource.data)) ||
            ('revokedAt' in resource.data && request.resource.data.revokedAt == resource.data.revokedAt) ||
            (!('revokedAt' in resource.data) &&
              request.resource.data.revokedAt == request.time &&
              request.resource.data.revokedBy == request.auth.uid)
          );
        allow delete: if isOwner(userId);

        match /oneTimeKeys/{keyId} {
          allow read: if isAuthenticated();
          allow create: if isOwner(userId) &&
            request.resource.data.key is map &&
            request.resource.data.keyId is string &&
            request.resource.data.algorithm is string &&
            request.resource.data.claimedBy == null;
          // A key can be claimed once by a participant in a shared chat.
          // Claimants cannot alter the published key material or its identity.
          allow update: if isAuthenticated() &&
            !('revokedAt' in get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data) &&
            resource.data.claimedBy == null &&
            request.resource.data.claimedBy == request.auth.uid &&
            request.resource.data.claimedAt == request.time &&
            request.resource.data.key == resource.data.key &&
            request.resource.data.keyId == resource.data.keyId &&
            request.resource.data.algorithm == resource.data.algorithm &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'chatId', 'claimedAt']) &&
            request.resource.data.chatId is string &&
            exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
            userId in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
          allow delete: if isOwner(userId);
        }

        match /fallbackKeyUsage/{keyId} {
          // A participant may mark a published fallback key as used. The
          // owning device reads this state during its next crypto sync.
          allow read: if isOwner(userId);
          allow create: if isAuthenticated() &&
            !('revokedAt' in get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data) &&
            request.resource.data.keyId is string &&
            request.resource.data.algorithm is string &&
            request.resource.data.algorithm == request.resource.data.keyId.split(':')[0] &&
            request.resource.data.keyId in get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data.fallbackKeys.keys() &&
            request.resource.data.chatId is string &&
            request.resource.data.claimedBy == request.auth.uid &&
            request.resource.data.usedAt == request.time &&
            exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
            userId in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
          allow update, delete: if isOwner(userId);
        }

        match /inbox/{eventId} {
          allow read, update, delete: if isOwner(userId);
          allow create: if isAuthenticated() &&
            !('revokedAt' in get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data) &&
            request.resource.data.senderUid == request.auth.uid &&
            request.resource.data.payload is string &&
            request.resource.data.payload.size() <= 900000 &&
            (
              request.auth.uid == userId ||
              (
                request.resource.data.chatId is string &&
                exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) &&
                request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
                userId in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants
              )
            );
        }
      }

    }

    match /calls/{callId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.receiverId);
      // Only the caller creates a call, and caller/receiver must be different accounts.
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.callerId &&
        request.resource.data.callerId != request.resource.data.receiverId;
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.receiverId) &&
        request.resource.data.callerId != request.resource.data.receiverId;

      match /offer/{docId} {
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
      }
      match /answer/{docId} {
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
      }
      match /candidates/{candidateId} {
        allow read: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
        allow create: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
      }
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (
            (
              request.resource.data.senderId == request.auth.uid &&
              request.resource.data.isEncrypted == true &&
              request.resource.data.encryptionMethod == 'matrix-megolm' &&
              request.resource.data.cryptoVersion == 2 &&
              request.resource.data.text is string &&
              (
                request.resource.data.type == 'text' ||
                (
                  (request.resource.data.type == 'image' || request.resource.data.type == 'file') &&
                  request.resource.data.attachmentEncrypted == true &&
                  request.resource.data.fileUrl is string
                )
              )
            ) ||
            (
              request.resource.data.senderId == 'ai' &&
              request.resource.data.isAi == true &&
              request.resource.data.type == 'text'
            )
          );
        // Message contents and encrypted attachment references are immutable.
        // Only delivery/read status and user feedback may be updated.
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feedback', 'feedbackAt']);
      }
    }
    
    match /usernames/{username} {
      // Authenticated users may resolve a username, but cannot enumerate or mutate
      // other users' username reservations.
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.usernameLower == username &&
        request.resource.data.username is string &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == username;
      allow update, delete: if false;
    }
    
    match /ai_feedback/{feedbackId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
  }
}
