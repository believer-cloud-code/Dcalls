rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return (!('email' in data)) &&
        (!('password' in data)) &&
        (data.displayName is string || !('displayName' in data)) &&
        (data.username is string || !('username' in data));
    }

    function isValidMessage(data) {
      return data.text is string &&
        (data.senderId is string || !('senderId' in data));
    }

    function isValidRecording(data) {
      return data.callId is string && data.summary is string;
    }

    function isValidMemory(data) {
      return data.topic is string && data.content is string;
    }

    function isValidContact(data) {
      return data.uid is string &&
        data.customName is string &&
        data.displayName is string;
    }

    match /usernames/{username} {
      // Authenticated users may resolve a username, but cannot enumerate or mutate
      // other users' username reservations.
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.usernameLower == username &&
        request.resource.data.username is string;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);

      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMessage(request.resource.data);
      }

      match /damai_messages/{messageId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMessage(request.resource.data);
      }

      match /damai_chats/{chatId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }

      match /calls/{callId} {
        allow read, create, update: if isOwner(userId);
      }

      match /recordings/{recordingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidRecording(request.resource.data);
      }

      match /ai_memory/{memoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMemory(request.resource.data);
      }

      match /feedback/{feedbackId} {
        allow read, create, update: if isOwner(userId);
      }

      match /contacts/{contactId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidContact(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /privateMessaging/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /calls/{callId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.receiverId);
      allow create: if isAuthenticated() &&
        (request.auth.uid == request.resource.data.callerId ||
         request.auth.uid == request.resource.data.receiverId);
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.receiverId);

      match /offer/{docId} {
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
      }
      match /answer/{docId} {
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
      }
      match /candidates/{candidateId} {
        allow read: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
        allow create: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
           request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
      }
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (request.auth.uid == request.resource.data.senderId || request.resource.data.senderId == 'ai');
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /ai_feedback/{feedbackId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
  }
}