export interface Env {
  BUCKET: R2Bucket;
  PUBLIC_URL?: string;
  FIREBASE_WEB_API_KEY?: string;
  DEEPSEEK_API_KEY?: string;
  OPENROUTER_API_KEY?: string;
  ALLOWED_ORIGINS?: string;
}

function getAllowedOrigins(env: Env) {
  return (env.ALLOWED_ORIGINS || '')
    .split(',')
    .map(value => value.trim())
    .filter(Boolean);
}

function applyCorsHeaders(request: Request, env: Env) {
  const origin = request.headers.get('Origin');
  const headers = new Headers({
    'Access-Control-Allow-Methods': 'GET,POST,PUT,DELETE,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
  });

  if (origin && getAllowedOrigins(env).includes(origin)) {
    headers.set('Access-Control-Allow-Origin', origin);
    headers.set('Access-Control-Allow-Credentials', 'true');
  }

  return headers;
}

class HttpError extends Error {
  status: number;

  constructor(status: number, message: string) {
    super(message);
    this.status = status;
  }
}

async function requireFirebaseUser(request: Request, env: Env) {
  const authorization = request.headers.get('Authorization');
  if (!authorization || !authorization.startsWith('Bearer ')) {
    throw new HttpError(401, 'Authentication required. Send a Firebase ID token in the Authorization header.');
  }

  const firebaseApiKey = env.FIREBASE_WEB_API_KEY;
  if (!firebaseApiKey) {
    throw new HttpError(500, 'Worker config is missing FIREBASE_WEB_API_KEY. Set this as a Cloudflare Worker secret.');
  }

  const token = authorization.replace('Bearer ', '').trim();
  const lookupRes = await fetch(
    `https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=${encodeURIComponent(firebaseApiKey)}`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken: token }),
    }
  );

  if (!lookupRes.ok) {
    throw new HttpError(401, 'Invalid or expired Firebase authentication token.');
  }

  const lookupJson = await lookupRes.json().catch(() => ({} as any));
  const uid = lookupJson?.users?.[0]?.localId;
  if (!uid) {
    throw new HttpError(401, 'Firebase user lookup failed.');
  }

  return { uid };
}

async function callDeepseek(endpoint: string, body: any, apiKey: string) {
  const res = await fetch(`https://api.deepseek.com${endpoint}`, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${apiKey}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(body),
  });

  if (!res.ok) {
    const txt = await res.text();
    throw new Error(`Deepseek error ${res.status}: ${txt}`);
  }

  return res.json();
}

async function callOpenRouter(endpoint: string, body: any, apiKey: string) {
  const res = await fetch(`https://openrouter.ai${endpoint}`, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${apiKey}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(body),
  });

  if (!res.ok) {
    const txt = await res.text();
    throw new Error(`OpenRouter error ${res.status}: ${txt}`);
  }

  return res.json();
}

async function handleAiRequest(request: Request, env: Env) {
  if (request.method === 'OPTIONS') {
    return new Response(null, { status: 204, headers: applyCorsHeaders(request, env) });
  }

  if (request.method !== 'POST') {
    return new Response('Method Not Allowed', { status: 405, headers: applyCorsHeaders(request, env) });
  }

  try {
    await requireFirebaseUser(request, env);
  } catch (err: any) {
    return Response.json({ error: err.message || 'Authentication failed' }, {
      status: err.status || 401,
      headers: applyCorsHeaders(request, env),
    });
  }

  const { action, prompt, context, text, audio } = await request.json().catch(() => ({}));
  const deepseekKey = env.DEEPSEEK_API_KEY;
  const openRouterKey = env.OPENROUTER_API_KEY;

  if (!deepseekKey && !openRouterKey) {
    return Response.json({ error: 'No AI provider configured on the Worker. Set DEEPSEEK_API_KEY or OPENROUTER_API_KEY as Cloudflare Worker secrets.' }, { status: 500, headers: applyCorsHeaders(request, env) });
  }

  try {
    if (action === 'chat') {
      const body = {
        model: 'deepseek-chat',
        messages: [
          { role: 'system', content: 'You are Damai, a helpful assistant.' },
          { role: 'user', content: `Context: ${context || ''}\nUser says: ${prompt}` },
        ],
      };

      if (deepseekKey) {
        const data = await callDeepseek('/chat/completions', body, deepseekKey);
        return Response.json({ response: data?.choices?.[0]?.message?.content ?? null }, { headers: applyCorsHeaders(request, env) });
      }

      const orData = await callOpenRouter('/api/v1/chat/completions', {
        model: 'google/gemini-pro-1.5',
        messages: body.messages,
      }, openRouterKey!);
      return Response.json({ response: orData?.choices?.[0]?.message?.content ?? null }, { headers: applyCorsHeaders(request, env) });
    }

    if (action === 'summary') {
      const body = {
        model: 'deepseek-chat',
        messages: [
          { role: 'system', content: 'You are an expert summarizer. Provide structured summary.' },
          { role: 'user', content: text },
        ],
      };

      if (deepseekKey) {
        const data = await callDeepseek('/chat/completions', body, deepseekKey);
        return Response.json({ summary: data?.choices?.[0]?.message?.content ?? null }, { headers: applyCorsHeaders(request, env) });
      }

      const orData = await callOpenRouter('/api/v1/chat/completions', {
        model: 'google/gemini-1.5',
        messages: body.messages,
      }, openRouterKey!);
      return Response.json({ summary: orData?.choices?.[0]?.message?.content ?? null }, { headers: applyCorsHeaders(request, env) });
    }

    if (action === 'transcribe') {
      if (!audio) {
        return Response.json({ error: 'Missing audio' }, { status: 400, headers: applyCorsHeaders(request, env) });
      }

      if (deepseekKey) {
        const data = await callDeepseek('/speech/transcribe', { model: 'deepseek-audio', audio }, deepseekKey);
        return Response.json({ transcript: data?.text ?? null }, { headers: applyCorsHeaders(request, env) });
      }

      return Response.json({ error: 'Transcription requires a provider such as DeepSeek. Configure DEEPSEEK_API_KEY or another transcription backend on the Worker.' }, { status: 501, headers: applyCorsHeaders(request, env) });
    }

    if (action === 'tts') {
      return Response.json({
        error: 'TTS is not configured on this Worker yet. Add a TTS provider/API (for example OpenAI or another speech service) and implement the route in the Worker before enabling this action.',
      }, { status: 501, headers: applyCorsHeaders(request, env) });
    }

    return Response.json({ error: 'Unknown action' }, { status: 400, headers: applyCorsHeaders(request, env) });
  } catch (err: any) {
    console.error('AI proxy error', err);
    return Response.json({ error: err?.message || 'Internal error' }, { status: 500, headers: applyCorsHeaders(request, env) });
  }
}

async function handleUploadRequest(request: Request, env: Env) {
  if (request.method === 'OPTIONS') {
    return new Response(null, { status: 204, headers: applyCorsHeaders(request, env) });
  }

  if (request.method !== 'POST') {
    return new Response('Method Not Allowed', { status: 405, headers: applyCorsHeaders(request, env) });
  }

  try {
    await requireFirebaseUser(request, env);
  } catch (err: any) {
    return Response.json({ error: err.message || 'Authentication failed' }, {
      status: err.status || 401,
      headers: applyCorsHeaders(request, env),
    });
  }

  const formData = await request.formData();
  const path = String(formData.get('path') || '');
  const file = formData.get('file');

  if (!path || !(file instanceof File)) {
    return Response.json({ error: 'Missing file or path' }, { status: 400, headers: applyCorsHeaders(request, env) });
  }

  const key = path.replace(/^\/+/, '');
  const object = await env.BUCKET.put(key, file, {
    httpMetadata: {
      contentType: file.type || 'application/octet-stream',
    },
  });

  const publicUrl = env.PUBLIC_URL ? `${env.PUBLIC_URL.replace(/\/+$/, '')}/${key}` : null;

  return Response.json({
    url: publicUrl || null,
    fileUrl: publicUrl || null,
    downloadURL: publicUrl || null,
    key,
    etag: object?.httpEtag || null,
  }, { headers: applyCorsHeaders(request, env) });
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const url = new URL(request.url);

    if (url.pathname === '/ai') {
      return handleAiRequest(request, env);
    }

    if (url.pathname === '/upload') {
      return handleUploadRequest(request, env);
    }

    return new Response('Not Found', { status: 404, headers: applyCorsHeaders(request, env) });
  },
};
